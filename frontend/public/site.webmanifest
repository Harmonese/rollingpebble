{
    "background_color": "#0e1113",
    "description": "Local lyrics timing, editing, import, and publishing workbench",
    "display": "standalone",
    "icons": [
        {
            "sizes": "192x192",
            "src": "./favicons/android-chrome-192x192.png",
            "type": "image/png"
        },
        {
            "sizes": "512x512",
            "src": "./favicons/android-chrome-512x512.png",
            "type": "image/png"
        }
    ],
    "name": "LRC Roller",
    "short_name": "LRC Roller",
    "start_url": "./",
    "theme_color": "#0e1113",
    "share_target": {
        "action": "./",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    }
}
