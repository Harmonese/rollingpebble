    "@types/react-dom": "^18.2.0",
    "core-js": "^3.42.0",
    "dprint": "^0.50.0",
    "gen_dep_tag": "^0.0.3",
    "lightningcss": "1.32.0",
    "oxlint": "^0.16.11",
    "rollup-plugin-externals": "^0.0.1",
