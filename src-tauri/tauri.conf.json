{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rolling Pebble",
  "version": "0.6.3",
  "identifier": "cn.harmonese.rollingpebble",
  "build": {
    "beforeBuildCommand": "pnpm -C frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop/bin/rollingpebble-backend*": "bin/"
    },
    "copyright": "Copyright (c) 2026 Harmonese",
    "category": "Utility",
    "shortDescription": "Local lyrics workstation",
    "longDescription": "Rolling Pebble is a local lyrics workstation for importing, timing, editing, and publishing LRC lyrics."
  }
}
