{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rolling Pebble",
  "version": "0.9.1",
  "identifier": "cn.harmonese.rollingpebble",
  "build": {
    "beforeBuildCommand": "pnpm -C frontend build && node desktop/build.mjs",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop/bin/rollingpebble-backend*": "bin/",
      "../desktop/python-runtime": "python-runtime/",
      "../desktop/engine": "engine/"
    },
    "copyright": "Copyright (c) 2026 Harmonese",
    "category": "Utility",
    "shortDescription": "Local lyrics workstation",
    "longDescription": "Rolling Pebble is a local lyrics workstation for editing, timing, translating, and publishing LRC lyrics, with project autosave and workspace recovery."
  }
}
